# El proyecto Supabase de Partimos. La llave es publicable: lo que protege los
# datos son las políticas RLS, no el secreto de esta cadena.
EXPO_PUBLIC_SUPABASE_URL=https://zcwueglgirqxwazhfidi.supabase.co
EXPO_PUBLIC_SUPABASE_LLAVE=sb_publishable_isfWgZ9aT6QTUDtubxr_Iw_xdPLvp9e

# «simulado» para trabajar sin red; «supabase» para hablar con la base de verdad.
EXPO_PUBLIC_FUENTE=supabase

# Búsqueda de sitios — Mapbox Search Box. El mismo jeton público que usa el
# sitio: está en web/.env.production, que explica por qué se versiona en claro.
#
# Sin esta variable, `hayBusquedaDeLugares` es falso: escribir una dirección no
# devuelve nada y la pantalla ofrece el campo libre. Los dos síntomas tienen
# esta única causa.
#
# A RESTRINGIR POR DOMINIO en la consola de Mapbox. Un jeton público sin
# restringir lo usa cualquiera y se factura en tu cuenta.
EXPO_PUBLIC_MAPBOX_TOKEN=
